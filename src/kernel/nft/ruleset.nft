table inet {{ table }}
delete table inet {{ table }}
table inet {{ table }} {
{%- for set in sets %}
	set {{ set.name }} {
		{{ set.declaration }}
		{%- if !set.elements.is_empty() %}
		elements = { {{ set.elements|join(", ") }} }
		{%- endif %}
	}
{%- endfor %}

	# A datagram that arrives for a client from an address it did not send to is written back by
	# sing-box from that address, which is not one of this host's. It starts no connection of this
	# host: tracked, it would be captured again by the rules, and the client's answer would match
	# it as a reply and leave without passing through sing-box. Untracked, it is not captured, and
	# the answer is new traffic of the client.
	chain output_raw {
		type filter hook output priority raw; policy accept;
		meta l4proto udp fib saddr type != local notrack
	}

	chain output {
		type route hook output priority mangle; policy accept;
		meta l4proto != { tcp, udp } return
		# sing-box marks its sockets through route.default_mark; other marked sockets belong to
		# software that routes its own traffic.
		meta mark != 0 return
		ct direction reply return
		ct mark & {{ mask }} == {{ local }} meta mark set meta mark & {{ keep }} | {{ local }} return
		# Rule changes apply to new connections only; rerouting an established one would break it.
		ct state != new return
		{%- for matchers in output.exclude %}
		{{ matchers }} return
		{%- endfor %}
		{%- for matchers in output.include %}
		{{ matchers }} goto output_selected
		{%- endfor %}
	}

	chain output_selected {
		# A tproxy reply socket cannot bind the address and port of a resolver on this host while
		# the resolver holds them, so queries to it are redirected instead.
		fib daddr type local th dport 53 ct mark set ct mark & {{ keep }} | {{ dns }} return
		fib daddr type { local, broadcast, multicast } return
		ip daddr 169.254.0.0/16 return
		ip6 daddr fe80::/10 return
		ct mark set ct mark & {{ keep }} | {{ local }} meta mark set meta mark & {{ keep }} | {{ local }}
	}

	chain dns_redirect_output {
		type nat hook output priority dstnat; policy accept;
		ct mark & {{ mask }} == {{ dns }} meta l4proto { tcp, udp } redirect to :{{ dns_port }}
	}

	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		meta l4proto != { tcp, udp } return
		# Local traffic marked in output comes back through lo.
		iif lo meta mark & {{ mask }} == {{ local }} goto deliver
		iif lo return
		meta mark != 0 return
		ct direction reply return
		ct mark & {{ mask }} == {{ forward }} meta mark set meta mark & {{ keep }} | {{ forward }} goto deliver
		ct state != new return
		{%- for matchers in prerouting.exclude %}
		{{ matchers }} return
		{%- endfor %}
		{%- for matchers in prerouting.include %}
		{{ matchers }} goto prerouting_selected
		{%- endfor %}
	}

	chain prerouting_selected {
		# Queries from selected clients to a resolver on this host go to uta's DNS inbound, as in
		# output_selected.
		fib daddr type local th dport 53 ct mark set ct mark & {{ keep }} | {{ dns }} return
		fib daddr type { local, broadcast, multicast } return
		ip daddr 169.254.0.0/16 return
		ip6 daddr fe80::/10 return
		ct mark set ct mark & {{ keep }} | {{ forward }} meta mark set meta mark & {{ keep }} | {{ forward }} goto deliver
	}

	# The redirect rewrites the destination to an address of the incoming interface.
	chain dns_redirect_prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		ct mark & {{ mask }} == {{ dns }} meta l4proto { tcp, udp } redirect to :{{ dns_port }}
	}

	# `tproxy` is a keyword and cannot name a chain.
	chain deliver {
		meta nfproto ipv4 meta l4proto { tcp, udp } tproxy ip to 127.0.0.1:{{ tproxy_port }} accept
		meta nfproto ipv6 meta l4proto { tcp, udp } tproxy ip6 to [::1]:{{ tproxy_port }} accept
	}

	# The tproxy and DNS inbounds listen on the wildcard address; only traffic uta hands to them
	# may reach them from outside.
	chain input {
		type filter hook input priority filter; policy accept;
		iif != lo fib daddr type local meta l4proto { tcp, udp } th dport {{ tproxy_port }} drop
		iif != lo fib daddr type local meta l4proto { tcp, udp } th dport {{ dns_port }} ct mark & {{ mask }} != {{ dns }} drop
	}
}
