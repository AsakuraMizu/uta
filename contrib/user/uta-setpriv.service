[Unit]
Description=uta transparent proxy

[Service]
# uta reports readiness once traffic is captured. sudo is the main process and clears the
# environment, so uta gets the user manager's notification socket explicitly.
Type=notify
NotifyAccess=all
# uta and sing-box run as the user with the two capabilities they need; sudo only grants them,
# which needs `sudo setpriv` without a password.
ExecStart=/usr/bin/sudo -n /usr/bin/setpriv --reuid=%U --regid=%G --init-groups \
    --inh-caps=+net_admin,+net_bind_service --ambient-caps=+net_admin,+net_bind_service -- \
    /usr/bin/env NOTIFY_SOCKET=%t/systemd/notify \
    %h/.local/bin/uta daemon --config %E/uta/uta.toml --rules %E/uta/rules --runtime-dir %t/uta
ExecStopPost=/usr/bin/sudo -n /usr/bin/setpriv --reuid=%U --regid=%G --init-groups \
    --inh-caps=+net_admin --ambient-caps=+net_admin -- %h/.local/bin/uta cleanup
RuntimeDirectory=uta
# Without this the journal attributes the daemon's output to sudo.
SyslogIdentifier=uta
# uta stops sing-box itself after removing its rules.
KillMode=mixed
Restart=on-failure

[Install]
WantedBy=default.target
